{
  "name": "blush-with-tee",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=admin-dashboard",
    "dev:client": "turbo run dev --filter=beauty-client-app",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:push": "pnpm --filter @blush/db db:push",
    "db:seed": "pnpm --filter @blush/db db:seed",
    "db:seed:demo": "pnpm --filter @blush/db db:seed --demo",
    "db:reconcile": "pnpm --filter @blush/db db:reconcile",
    "db:reset": "pnpm --filter @blush/db db:reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
