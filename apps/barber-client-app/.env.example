# Shared database (same MySQL instance/schema as admin-dashboard)
DATABASE_URL=

# Session JWT signing secret
JWT_SECRET=

# OAuth identity provider (same provider as admin-dashboard)
OAUTH_SERVER_URL=
NEXT_PUBLIC_OAUTH_PORTAL_URL=
