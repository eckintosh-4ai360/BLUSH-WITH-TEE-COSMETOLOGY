# openId of the account that should be auto-promoted to role "admin" on first sign-in
OWNER_OPEN_ID=

# Forge storage/notification backend (file uploads, owner notifications)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
