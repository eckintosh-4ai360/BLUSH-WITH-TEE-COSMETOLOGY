# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The same central database the admin system uses. There is no second database:
# a product edited in admin is the product this site sells.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs the session cookie. Each app keeps its own session; sharing this value
# between apps is optional and not required.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Storage (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blush-with-tee

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Paystack. The secret key both authorises server-side verification calls and
# validates the webhook signature, so a webhook cannot be forged without it.
# Leave PAYSTACK_SECRET_KEY empty in development to use the built-in manual
# gateway, which never contacts a provider.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Public site origin, used to build payment callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
