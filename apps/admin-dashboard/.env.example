# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# One central Postgres database shared by the admin system, the public site and
# both portals. DATABASE_URL is the pooled endpoint the apps use;
# DIRECT_DATABASE_URL is the direct endpoint drizzle-kit needs for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs the session cookie. Use a long random value, and a DIFFERENT one per
# environment. Rotating it signs everybody out, which is the intended effect.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Storage (Cloudinary)
# ---------------------------------------------------------------------------
# Admissions documents, student photos, receipts and product images. Stored as
# authenticated assets and served through /api/manus-storage/{key}, never
# linked to directly, so private documents are not on guessable public URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blush-with-tee

# ---------------------------------------------------------------------------
# Messaging (optional)
# ---------------------------------------------------------------------------
# Email and SMS are normally configured from Settings, in the dashboard, and
# the credentials are stored in the database. These variables exist for
# deployments that would rather keep secrets out of the database entirely: set
# one and it wins over whatever is saved, and the settings page shows the field
# as read-only rather than pretending it can be changed there.
# MNOTIFY_API_KEY=
# MNOTIFY_SENDER_ID=
# MNOTIFY_BASE_URL=https://api.mnotify.com/api/sms/quick
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Guards /api/messaging/flush, which retries anything that did not send. Point
# a scheduler at that URL every few minutes and send this as a bearer token.
# Without it the route refuses every request.
# MESSAGING_CRON_SECRET=

# ---------------------------------------------------------------------------
# Links
# ---------------------------------------------------------------------------
# Public site origin, used for certificate verification links shown in admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# This dashboard's own origin. Low-stock reports are texted and mailed to
# administrators as a link, and that link has to open on the app they are
# signed in to - the file is private and the public site cannot serve it.
# Defaults to NEXT_PUBLIC_SITE_URL when the two share an origin.
ADMIN_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Assistant (Groq)
# ---------------------------------------------------------------------------
# Powers the assistant panel in the dashboard header (Ctrl + /). It answers
# from this database through a fixed catalogue of read-only lookups, each one
# gated by the same permission as the screen that shows the same figures - so
# it can never tell a storekeeper what an accountant sees.
#
# Get a key from https://console.groq.com. Without one the panel says it is
# switched off rather than failing on the first question.
GROQ_API_KEY=
# The model to run on. Defaults to openai/gpt-oss-120b, the strongest
# tool-calling model Groq serves. Free-tier keys are metered at 8,000 tokens a
# minute, which is roughly one question at a time; a paid plan removes that.
GROQ_MODEL=openai/gpt-oss-120b
