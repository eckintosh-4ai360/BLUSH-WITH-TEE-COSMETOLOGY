# Shared Neon Postgres database (same instance/schema as barber-client-app).
# DATABASE_URL is the pooled endpoint and is what the app uses.
# DIRECT_DATABASE_URL is the direct endpoint, used only by drizzle-kit
# migrations (`pnpm db:push`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Session JWT signing secret (must match the value barber-client-app uses only
# if you want the two apps' JWTs to be mutually verifiable; otherwise any
# secret is fine since sessions are already independent per app/__Host- cookie)
JWT_SECRET=

# Cloudinary (file uploads: admissions documents, gallery, product photos).
# Assets are stored as `authenticated` resources and served through
# /api/manus-storage/{key}, never linked to directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blush-with-tee

# OAuth identity provider (same provider as barber-client-app)
OAUTH_SERVER_URL=
NEXT_PUBLIC_OAUTH_PORTAL_URL=
NEXT_PUBLIC_APP_ID=

# openId of the account that should be auto-promoted to role "admin" on first sign-in
OWNER_OPEN_ID=

# Forge backend for owner notifications (storage now goes through Cloudinary)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
